{
  "appId": "com.pichallenge.app",
  "appName": "Pi Challenge",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0a0a1a",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "iosSpinnerStyle": "small",
      "spinnerColor": "#00f5d4"
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#0a0a1a"
    }
  }
}
